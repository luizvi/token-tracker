{
  "name": "@tracker/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./schema": {
      "import": "./dist/schema.js",
      "default": "./src/schema.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "default": "./src/client.ts"
    },
    "./migrate": {
      "import": "./dist/migrate.js",
      "default": "./src/migrate.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/migrations dist/migrations",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@tracker/shared": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.4"
  },
  "devDependencies": {
    "@tracker/config": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
